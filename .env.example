# OpenDART에서 발급받은 40자리 인증키 (프리로드 배치에만 필요, 배포 런타임에는 불필요)
DART_API_KEY=
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.4-mini
OPENAI_MAX_OUTPUT_TOKENS=3000
ANALYSIS_MAX_SOURCE_CHARS=40000

# 기본값: 프로젝트 루트 data/dart-career.db (SQLite)
# Supabase 예시:
#   마이그레이션/프리로드 - 직결(Session, 5432):
#     postgresql+psycopg://postgres:<PW>@db.<ref>.supabase.co:5432/postgres
#   배포 런타임 - 트랜잭션 풀러(6543):
#     postgresql+psycopg://postgres.<ref>:<PW>@aws-0-<region>.pooler.supabase.com:6543/postgres
DATABASE_URL=

# 배포(읽기 전용) 환경에서 1/true로 설정: 요청 시점 DART 호출·쓰기 엔드포인트 비활성화
READ_ONLY=
